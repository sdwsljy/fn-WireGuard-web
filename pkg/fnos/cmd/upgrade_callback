#!/bin/bash
# 升级后处理（应用中心"升级"流程）—— 无损升级后清理旧文件：
#   迁移 4 类旧数据，每类都按【复制 → 校验目标非空且与原件字节数一致 → 单独删除原件】三步执行，
#   绝不盲删整目录，目录仅用非递归 rmdir 清理完全空的壳。
#   程序文件已由官方流程刷新到 TRIM_APPDEST，直接使用。
set -u

DATA_DIR="${TRIM_PKGVAR:-/var/apps/fn-wg-web/var}"
ETC_DIR="${TRIM_PKGETC:-/var/apps/fn-wg-web/etc}"
LEGACY_DIR="/usr/fn-wg-web"
LEGACY_BACKUP="$DATA_DIR/legacy-backup"
STATE_FILE="$DATA_DIR/state.json"

# 0. 目录初始化
mkdir -p "$DATA_DIR" "$ETC_DIR"

# ===== 通用：安全迁移+清理单个文件 ==========================================
_safe_migrate_file() {
    local src="$1" dst="$2"
    [ -f "$src" ] || return 0
    if [ ! -f "$dst" ]; then
        mkdir -p "$(dirname "$dst")" 2>/dev/null || true
        cp -f "$src" "$dst" 2>/dev/null || true
    fi
    if [ -f "$src" ] && [ -f "$dst" ]; then
        local ss ds
        ss=$(stat -c '%s' "$src" 2>/dev/null || stat -f '%z' "$src" 2>/dev/null || echo "-1")
        ds=$(stat -c '%s' "$dst" 2>/dev/null || stat -f '%z' "$dst" 2>/dev/null || echo "-2")
        if [ "$ds" -gt 0 ] 2>/dev/null && [ "$ss" = "$ds" ] 2>/dev/null; then
            rm -f "$src" 2>/dev/null || true
            [ ! -e "$src" ] && echo "[fn-wg-web] 升级：迁移并清理成功 $src (${ds}B) -> $dst"
        fi
    fi
}

# ===== 1) state.json ========================================================
if [ -f "$STATE_FILE" ] && [ -f "$LEGACY_DIR/state.json" ]; then
    # state.json 已在持久卷；若与旧文件尺寸一致则删旧副本
    ss=$(stat -c '%s' "$LEGACY_DIR/state.json" 2>/dev/null || stat -f '%z' "$LEGACY_DIR/state.json" 2>/dev/null || echo "-1")
    ds=$(stat -c '%s' "$STATE_FILE" 2>/dev/null || stat -f '%z' "$STATE_FILE" 2>/dev/null || echo "-2")
    if [ "$ds" -gt 0 ] 2>/dev/null && [ "$ss" = "$ds" ] 2>/dev/null; then
        rm -f "$LEGACY_DIR/state.json" 2>/dev/null || true
        [ ! -e "$LEGACY_DIR/state.json" ] && echo "[fn-wg-web] 升级：已清理与持久卷一致的旧 state.json（$LEGACY_DIR/state.json, ${ds}B）"
    fi
elif [ ! -f "$STATE_FILE" ]; then
    _safe_migrate_file "$LEGACY_DIR/state.json" "$STATE_FILE"
fi

# ===== 2) 旧日志（/var/log/fn-wg-web.log* → DATA_DIR）========================
if [ -d /var/log ]; then
    for oldlog in /var/log/fn-wg-web.log /var/log/fn-wg-web.log.*; do
        [ -e "$oldlog" ] || continue
        base=$(basename "$oldlog")
        newlog="$DATA_DIR/$base"
        _safe_migrate_file "$oldlog" "$newlog"
    done
fi

# ===== 3) LEGACY_DIR/etc → TRIM_PKGETC（递归逐文件，文件迁完清空空目录壳）=====
if [ -d "$LEGACY_DIR/etc" ]; then
    find "$LEGACY_DIR/etc" -type f 2>/dev/null | sort -r | while read -r src; do
        rel="${src#$LEGACY_DIR/etc/}"
        dst="$ETC_DIR/$rel"
        _safe_migrate_file "$src" "$dst"
    done
    find "$LEGACY_DIR/etc" -depth -type d 2>/dev/null | while read -r d; do
        rmdir "$d" 2>/dev/null || true
    done
    rmdir "$LEGACY_DIR/etc" 2>/dev/null || true
fi

# ===== 4) LEGACY_DIR 散落的 *.json/*.conf → legacy-backup（删原件）==========
if [ -d "$LEGACY_DIR" ] && { ls "$LEGACY_DIR"/*.json "$LEGACY_DIR"/*.conf >/dev/null 2>&1; }; then
    mkdir -p "$LEGACY_BACKUP"
    find "$LEGACY_DIR" -maxdepth 1 -type f \( -name "*.json" -o -name "*.conf" \) 2>/dev/null | while read -r src; do
        base=$(basename "$src")
        [ "$base" = "state.json" ] && continue
        dst="$LEGACY_BACKUP/$base"
        _safe_migrate_file "$src" "$dst"
    done
fi

# ===== 最后：LEGACY_DIR 若完全空则删除壳 =====================================
if [ -d "$LEGACY_DIR" ]; then
    find "$LEGACY_DIR" -depth -type d 2>/dev/null | while read -r d; do
        rmdir "$d" 2>/dev/null || true
    done
    rmdir "$LEGACY_DIR" 2>/dev/null || true
    [ ! -d "$LEGACY_DIR" ] && echo "[fn-wg-web] 升级：旧运行目录 $LEGACY_DIR 已空，已清理壳目录"
fi

# ===== 5) 按容器实况修正 deployed ============================================
if [ -f "$STATE_FILE" ]; then
    if docker inspect wireguard >/dev/null 2>&1; then
        python3 -c "
import json
p = '$STATE_FILE'
s = json.load(open(p))
s.setdefault('container', {})['deployed'] = True
json.dump(s, open(p, 'w'), ensure_ascii=False, indent=2)
" 2>/dev/null || true
        echo "[fn-wg-web] 升级：wireguard 容器仍在运行，无需重新部署"
    else
        python3 -c "
import json
p = '$STATE_FILE'
s = json.load(open(p))
s.setdefault('container', {})['deployed'] = False
json.dump(s, open(p, 'w'), ensure_ascii=False, indent=2)
" 2>/dev/null || true
    fi
fi

exit 0
