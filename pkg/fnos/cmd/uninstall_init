#!/bin/bash
# 卸载前检查：若存在在线客户端将提示
# 按优先级依次检查官方持久卷（TRIM_PKGVAR）与旧运行目录
DATA_DIR="${TRIM_PKGVAR:-/var/apps/fn-wg-web/var}"
STATE_FILE=""
if [ -f "$DATA_DIR/state.json" ]; then
    STATE_FILE="$DATA_DIR/state.json"
elif [ -f /usr/fn-wg-web/state.json ]; then
    STATE_FILE="/usr/fn-wg-web/state.json"
fi
if [ -n "$STATE_FILE" ]; then
    count=$(python3 -c "import json;print(len(json.load(open('$STATE_FILE')).get('peers',[])))" 2>/dev/null)
    if [ -n "$count" ] && [ "$count" -gt 0 ] 2>/dev/null; then
        echo "当前有 ${count} 个 WireGuard 客户端，卸载后这些客户端将全部失效！"
    fi
fi
exit 0
