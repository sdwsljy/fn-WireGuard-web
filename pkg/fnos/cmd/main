#!/bin/bash
# fn-wg-web - WireGuard 服务端可视化管理（fnOS 应用生命周期脚本）
#
# 目录策略（对齐 fnOS 官方 resource / 环境变量规范）：
#   程序文件目录  TRIM_APPDEST  （/usr/local/apps/@appcenter/fn-wg-web/target）
#   静态配置目录  TRIM_PKGETC   （官方 etc/，→ /vol[x]/@appconf/fn-wg-web）
#   运行时数据    TRIM_PKGVAR   （官方 var/，→ /vol[x]/@appdata/fn-wg-web）
#   服务入口      TRIM_SERVICE_PORT（已弃用，改为统一网关）→ 见 ui/config gatewayPrefix/gatewaySocket
#   网关 Socket   TRIM_APPDEST/app.sock（fnOS 统一网关转发目标）
#   临时日志      TRIM_TEMP_LOGFILE（生命周期脚本错误输出）
#   应用名/版本    TRIM_APPNAME / TRIM_APPVER（来自 manifest）
#
# 无损升级迁移 + 清理（start 阶段最后兜底）：每类迁移都按
#   【复制（仅当目标不存在）→ 校验目标非空且尺寸等于源 → 删除原件】
# 三步执行；绝不盲删整目录，目录仅用非递归 rmdir 清理完全空壳。
# WireGuard 服务端运行在 linuxserver/wireguard 容器中（应用界面一键部署）。
set -u

APPDEST="${TRIM_APPDEST:-/usr/local/apps/@appcenter/fn-wg-web/target}"
ETC_DIR="${TRIM_PKGETC:-/var/apps/fn-wg-web/etc}"
DATA_DIR="${TRIM_PKGVAR:-/var/apps/fn-wg-web/var}"
SOCKET="${WG_SOCKET:-$APPDEST/app.sock}"
LEGACY_DIR="/usr/fn-wg-web"
LEGACY_BACKUP="$DATA_DIR/legacy-backup"
MANAGER="$APPDEST/wg-manager.py"

# 运行日志：默认写进持久卷 DATA_DIR/fn-wg-web.log，与 wg-manager.py 内部 LOG_FILE 解析一致
LOG_FILE="${WG_LOG_FILE:-$DATA_DIR/fn-wg-web.log}"

# ===== 通用：安全迁移+清理单个文件 ==========================================
_safe_migrate_file() {
    local src="$1" dst="$2"
    [ -f "$src" ] || return 0
    if [ ! -f "$dst" ]; then
        mkdir -p "$(dirname "$dst")" 2>/dev/null || true
        cp -f "$src" "$dst" 2>/dev/null || true
    fi
    if [ -f "$src" ] && [ -f "$dst" ]; then
        local ss ds
        ss=$(stat -c '%s' "$src" 2>/dev/null || stat -f '%z' "$src" 2>/dev/null || echo "-1")
        ds=$(stat -c '%s' "$dst" 2>/dev/null || stat -f '%z' "$dst" 2>/dev/null || echo "-2")
        if [ "$ds" -gt 0 ] 2>/dev/null && [ "$ss" = "$ds" ] 2>/dev/null; then
            rm -f "$src" 2>/dev/null || true
            [ ! -e "$src" ] && echo "[fn-wg-web] main: 迁移并清理成功 $src (${ds}B) -> $dst" >>"$LOG_FILE" 2>/dev/null || true
        fi
    fi
}

case $1 in
start)
    # 0. 目录初始化（幂等）
    mkdir -p "$DATA_DIR" "$ETC_DIR" "$LEGACY_BACKUP"

    # ===== 1) state.json =====================================================
    if [ -f "$DATA_DIR/state.json" ] && [ -f "$LEGACY_DIR/state.json" ]; then
        ss=$(stat -c '%s' "$LEGACY_DIR/state.json" 2>/dev/null || stat -f '%z' "$LEGACY_DIR/state.json" 2>/dev/null || echo "-1")
        ds=$(stat -c '%s' "$DATA_DIR/state.json" 2>/dev/null || stat -f '%z' "$DATA_DIR/state.json" 2>/dev/null || echo "-2")
        if [ "$ds" -gt 0 ] 2>/dev/null && [ "$ss" = "$ds" ] 2>/dev/null; then
            rm -f "$LEGACY_DIR/state.json" 2>/dev/null || true
        fi
    elif [ ! -f "$DATA_DIR/state.json" ]; then
        _safe_migrate_file "$LEGACY_DIR/state.json" "$DATA_DIR/state.json"
    fi

    # ===== 2) 旧日志（/var/log → DATA_DIR，含轮转历史）=====================
    if [ -d /var/log ]; then
        for oldlog in /var/log/fn-wg-web.log /var/log/fn-wg-web.log.*; do
            [ -e "$oldlog" ] || continue
            base=$(basename "$oldlog")
            newlog="$DATA_DIR/$base"
            _safe_migrate_file "$oldlog" "$newlog"
        done
    fi

    # ===== 3) LEGACY_DIR/etc → TRIM_PKGETC =================================
    if [ -d "$LEGACY_DIR/etc" ]; then
        find "$LEGACY_DIR/etc" -type f 2>/dev/null | sort -r | while read -r src; do
            rel="${src#$LEGACY_DIR/etc/}"
            dst="$ETC_DIR/$rel"
            _safe_migrate_file "$src" "$dst"
        done
        find "$LEGACY_DIR/etc" -depth -type d 2>/dev/null | while read -r d; do
            rmdir "$d" 2>/dev/null || true
        done
        rmdir "$LEGACY_DIR/etc" 2>/dev/null || true
    fi

    # ===== 4) LEGACY_DIR 散落的 *.json/*.conf → legacy-backup =============
    if [ -d "$LEGACY_DIR" ] && { ls "$LEGACY_DIR"/*.json "$LEGACY_DIR"/*.conf >/dev/null 2>&1; }; then
        find "$LEGACY_DIR" -maxdepth 1 -type f \( -name "*.json" -o -name "*.conf" \) 2>/dev/null | while read -r src; do
            base=$(basename "$src")
            [ "$base" = "state.json" ] && continue
            dst="$LEGACY_BACKUP/$base"
            _safe_migrate_file "$src" "$dst"
        done
    fi

    # ===== LEGACY_DIR 空壳清理 ==============================================
    if [ -d "$LEGACY_DIR" ]; then
        find "$LEGACY_DIR" -depth -type d 2>/dev/null | while read -r d; do
            rmdir "$d" 2>/dev/null || true
        done
        rmdir "$LEGACY_DIR" 2>/dev/null || true
    fi

    # ===== 5) 启动 Web 管理服务（统一网关模式：监听 Unix Socket，不占用 TCP 端口）=====
    # 清理可能遗留的陈旧 socket 文件（进程已退出时）
    rm -f "$SOCKET" 2>/dev/null || true
    if ! pgrep -f "wg-manager.py --socket ${SOCKET}" >/dev/null 2>&1; then
        WG_WEB_BASE="$APPDEST" \
        WG_ETC_BASE="$ETC_DIR" \
        WG_DATA_BASE="$DATA_DIR" \
        WG_LOG_FILE="$LOG_FILE" \
            nohup python3 -u "$MANAGER" --socket "$SOCKET" \
            >>"$LOG_FILE" 2>&1 &
        # 等待 socket 就绪：fnOS 统一网关需要 socket 文件存在后才能转发请求。
        # 首轮绑定在 Python 侧已提前到模式检测之前，正常情况下 1-2 秒内就绪；
        # 留足余量（最长 30 秒）避免 docker 探测等慢启动造成误报。
        i=0
        while [ "$i" -lt 30 ]; do
            [ -S "$SOCKET" ] && break
            sleep 1
            i=$((i + 1))
            # 已等待至少 1 秒且进程消失 → 立即失败，避免无限等待
            if ! pgrep -f "wg-manager.py --socket ${SOCKET}" >/dev/null 2>&1; then
                break
            fi
        done
        if [ ! -S "$SOCKET" ]; then
            {
                echo "[fn-wg-web] 统一网关 Socket 未就绪: $SOCKET"
                echo "[fn-wg-web] 最近日志（$LOG_FILE）:"
                tail -n 20 "$LOG_FILE" 2>/dev/null || echo "(日志不可读)"
            } >>"${TRIM_TEMP_LOGFILE:-/dev/null}" 2>/dev/null || true
            exit 1
        fi
    fi
    exit 0
    ;;
stop)
    pkill -f "wg-manager.py --socket ${SOCKET}" 2>/dev/null || true
    rm -f "$SOCKET" 2>/dev/null || true
    exit 0
    ;;
status)
    if pgrep -f "wg-manager.py --socket ${SOCKET}" >/dev/null 2>&1; then
        exit 0
    else
        exit 3
    fi
    ;;
*)
    msg="Unknown command: $1"
    if [ -n "${TRIM_TEMP_LOGFILE:-}" ]; then
        echo "$msg" >>"$TRIM_TEMP_LOGFILE" 2>/dev/null || true
    fi
    echo "$msg" >&2
    exit 1
    ;;
esac
